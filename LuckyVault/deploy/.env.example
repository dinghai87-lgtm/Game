# 复制成 .env 后填写 · Copy to .env and fill in
DOMAIN=casino.example.com
ADMIN_USER=admin
ADMIN_PASS=change-me-to-a-long-password
# 允许 App 访问的来源（打包成 App 后填）· Extra allowed origins for the mobile app
ALLOWED_ORIGINS=capacitor://localhost,https://localhost
# 可选：告警 Optional alerts (Slack/Discord/Teams webhook, or email via MAIL_*)
ALERT_WEBHOOK=
ALERT_EMAIL=
MAIL_API_KEY=
MAIL_FROM=
# 可选：改用 PostgreSQL（不填则用内置 SQLite）· Optional PostgreSQL
DATABASE_URL=

# --- App Store / Google Play release ---
# Turn OFF fake "sandbox" payments in production (coins can then only be bought through the stores)
PAY_SANDBOX=0
# Apple in-app purchases (App Store Connect → App → App Information → App-Specific Shared Secret)
APPLE_SHARED_SECRET=
APPLE_BUNDLE_ID=com.wantai.luckyvault
# Google Play in-app purchases (service account JSON key file inside the container, e.g. /app/data/play-sa.json)
GOOGLE_PACKAGE_NAME=com.wantai.luckyvault
GOOGLE_SERVICE_ACCOUNT=
