{
  "name": "hero-defense-app",
  "version": "1.0.0",
  "private": true,
  "description": "Hero Defense / 英雄塔防 — native app wrapper (Capacitor) for Android and iOS. © 2026 万泰游戏开发",
  "scripts": {
    "prepare-web": "node prepare.js",
    "assets": "npx --yes @capacitor/assets@3 generate --assetPath assets --iconBackgroundColor \"#15100b\" --iconBackgroundColorDark \"#15100b\" --splashBackgroundColor \"#15100b\" --splashBackgroundColorDark \"#15100b\"",
    "sync": "node prepare.js && npx cap sync && node patch-native.js"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/local-notifications": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
